  "components": {
    "schemas": {
      "AccountInfoResponse": {
        "type": "object",
        "properties": {
          "domainName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddAdditionalProductNodeRequest": {
        "required": [
          "productId"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ChangeInstanceTypeRequest": {
        "required": [
          "instanceType",
          "productId"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "instanceType": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ChangeStorageRequest": {
        "required": [
          "productId",
          "size",
          "storageType"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "storageType": {
            "$ref": "#/components/schemas/StorageType"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "iops": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "throughput": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CloudProvider": {
        "enum": [
          "Aws",
          "Azure",
          "Gcp"
        ],
        "type": "string"
      },
      "ContractTerm": {
        "enum": [
          "OnDemand",
          "Yearly"
        ],
        "type": "string"
      },
      "CpuPriority": {
        "enum": [
          "Shared",
          "Basic",
          "Standard",
          "Performance"
        ],
        "type": "string"
      },
      "DeploymentType": {
        "enum": [
          "Standard",
          "Serverless"
        ],
        "type": "string"
      },
      "HardwareInfoResponse": {
        "type": "object",
        "properties": {
          "cpuPriority": {
            "$ref": "#/components/schemas/CpuPriority"
          },
          "cpus": {
            "type": "integer",
            "format": "int32"
          },
          "ram": {
            "type": "number",
            "format": "double"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageResponse"
          },
          "additionalStorage": {
            "$ref": "#/components/schemas/StorageResponse"
          }
        },
        "additionalProperties": false
      },
      "InstanceTypeItemResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "tier": {
            "$ref": "#/components/schemas/ProductTier"
          },
          "parameters": {
            "$ref": "#/components/schemas/InstanceTypeParametersResponse"
          }
        },
        "additionalProperties": false
      },
      "InstanceTypeParametersResponse": {
        "type": "object",
        "properties": {
          "virtualCpus": {
            "type": "integer",
            "format": "int32"
          },
          "ram": {
            "type": "number",
            "format": "double"
          },
          "availableDiskSizes": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          },
          "numberOfNodes": {
            "type": "integer",
            "format": "int32"
          },
          "availableStorageTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorageTypeInfoResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InstanceTypesResponse": {
        "type": "object",
        "properties": {
          "instanceTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstanceTypeItemResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "IopsRangeResponse": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "format": "int32"
          },
          "max": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PaymentOption": {
        "enum": [
          "Monthly",
          "YearlyUpfront"
        ],
        "type": "string"
      },
      "PaymentPlanResponse": {
        "type": "object",
        "properties": {
          "contractTerm": {
            "$ref": "#/components/schemas/ContractTerm"
          },
          "contractValidUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "paymentOption": {
            "$ref": "#/components/schemas/PaymentOption"
          }
        },
        "additionalProperties": false
      },
      "ProductCreateRequest": {
        "required": [
          "allowedIps",
          "cloudProvider",
          "diskSize",
          "displayName",
          "instanceTypeName",
          "region",
          "releaseChannel",
          "storageTypeName",
          "tier"
        ],
        "type": "object",
        "properties": {
          "cloudProvider": {
            "$ref": "#/components/schemas/CloudProvider"
          },
          "instanceTypeName": {
            "minLength": 1,
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "releaseChannel": {
            "minLength": 1,
            "type": "string"
          },
          "subdomainName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "tier": {
            "$ref": "#/components/schemas/ProductTier"
          },
          "region": {
            "minLength": 1,
            "type": "string"
          },
          "diskSize": {
            "type": "integer",
            "format": "int32"
          },
          "iops": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "throughput": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "storageTypeName": {
            "$ref": "#/components/schemas/StorageType"
          },
          "allowedIps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diskLayout": {
            "$ref": "#/components/schemas/PublicApiDiskLayout"
          },
          "deploymentType": {
            "$ref": "#/components/schemas/DeploymentType"
          }
        },
        "additionalProperties": false
      },
      "ProductCreatedResponse": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductDetailsResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "subdomainName": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "instanceType": {
            "type": "string",
            "nullable": true
          },
          "cloudProvider": {
            "$ref": "#/components/schemas/CloudProvider"
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          },
          "tier": {
            "$ref": "#/components/schemas/ProductTier"
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "dns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "nodeTags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "releaseChannel": {
            "type": "string",
            "nullable": true
          },
          "paymentPlan": {
            "$ref": "#/components/schemas/PaymentPlanResponse"
          },
          "hardwareInfo": {
            "$ref": "#/components/schemas/HardwareInfoResponse"
          },
          "security": {
            "$ref": "#/components/schemas/SecurityResponse"
          }
        },
        "additionalProperties": false
      },
      "ProductListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
